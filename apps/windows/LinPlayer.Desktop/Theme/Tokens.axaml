<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 普通主题与手机共享语义色；桌面弹层表面使用叠加在背景后的实色，避免透出背后内容。 -->

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="BgColor">#0D0C12</Color>
      <Color x:Key="PanelColor">#1A191F</Color>
      <Color x:Key="PanelAltColor">#26252A</Color>
      <Color x:Key="LineColor">#12FFFFFF</Color>
      <Color x:Key="LineStrongColor">#24FFFFFF</Color>
      <Color x:Key="InkColor">#F5F5F7</Color>
      <Color x:Key="Ink2Color">#9996A8</Color>
      <Color x:Key="Ink3Color">#6E6880</Color>
      <Color x:Key="AccentColor">#F4AD39</Color>
      <Color x:Key="AccentInkColor">#20160A</Color>
      <Color x:Key="AccentSoftColor">#2EF4AD39</Color>
      <Color x:Key="OkColor">#5CD6A0</Color>
      <Color x:Key="WarnColor">#F5A524</Color>
      <Color x:Key="DangerColor">#FF6B5E</Color>
      <Color x:Key="DangerBgColor">#4a1d28</Color>
      <Color x:Key="DangerInkColor">#ffd9de</Color>
      <Color x:Key="Medal1Color">#F5A524</Color>
      <Color x:Key="Medal2Color">#c9cfda</Color>
      <Color x:Key="Medal3Color">#c6803f</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="BgColor">#FAF7FC</Color>
      <Color x:Key="PanelColor">#EFECF1</Color>
      <Color x:Key="PanelAltColor">#E7E5E9</Color>
      <Color x:Key="LineColor">#0F000000</Color>
      <Color x:Key="LineStrongColor">#1F000000</Color>
      <Color x:Key="InkColor">#1A1622</Color>
      <Color x:Key="Ink2Color">#514A60</Color>
      <Color x:Key="Ink3Color">#615A70</Color>
      <Color x:Key="AccentColor">#8A5A00</Color>
      <Color x:Key="AccentInkColor">#FFFBF2</Color>
      <Color x:Key="AccentSoftColor">#1F8A5A00</Color>
      <Color x:Key="OkColor">#1F7A55</Color>
      <Color x:Key="WarnColor">#8A5A00</Color>
      <Color x:Key="DangerColor">#C7554E</Color>
      <Color x:Key="DangerBgColor">#f7dfe0</Color>
      <Color x:Key="DangerInkColor">#6e2430</Color>
      <Color x:Key="Medal1Color">#b8862e</Color>
      <Color x:Key="Medal2Color">#7d8797</Color>
      <Color x:Key="Medal3Color">#a0612a</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="PrivateNeonCyan" Color="#36FFF3" />
  <SolidColorBrush x:Key="PrivateNeonRed" Color="#FF426D" />

  <SolidColorBrush x:Key="Bg" Color="{DynamicResource BgColor}" />
  <SolidColorBrush x:Key="Panel" Color="{DynamicResource PanelColor}" />
  <SolidColorBrush x:Key="PanelAlt" Color="{DynamicResource PanelAltColor}" />
  <SolidColorBrush x:Key="Line" Color="{DynamicResource LineColor}" />
  <SolidColorBrush x:Key="LineStrong" Color="{DynamicResource LineStrongColor}" />
  <SolidColorBrush x:Key="Ink" Color="{DynamicResource InkColor}" />
  <SolidColorBrush x:Key="Ink2" Color="{DynamicResource Ink2Color}" />
  <SolidColorBrush x:Key="Ink3" Color="{DynamicResource Ink3Color}" />
  <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="AccentInk" Color="{DynamicResource AccentInkColor}" />
  <SolidColorBrush x:Key="AccentSoft" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="Ok" Color="{DynamicResource OkColor}" />
  <SolidColorBrush x:Key="Warn" Color="{DynamicResource WarnColor}" />
  <SolidColorBrush x:Key="Danger" Color="{DynamicResource DangerColor}" />
  <SolidColorBrush x:Key="DangerBg" Color="{DynamicResource DangerBgColor}" />
  <SolidColorBrush x:Key="DangerInk" Color="{DynamicResource DangerInkColor}" />
  <!-- 排行榜前三名的名次色(金 / 银 / 铜);第四名起用 Ink -->
  <SolidColorBrush x:Key="Medal1" Color="{DynamicResource Medal1Color}" />
  <SolidColorBrush x:Key="Medal2" Color="{DynamicResource Medal2Color}" />
  <SolidColorBrush x:Key="Medal3" Color="{DynamicResource Medal3Color}" />

  <!--
    滑块(进度条 / 音量)的配色。
    覆盖的是 **Fluent 主题自己的资源键**,不是去改模板里那几个部件的名字 ——
       部件名在 Avalonia 大版本之间会变,而且**名字写错不报错,只是静默不生效**。
       资源键这一层稳得多。
    已播那段用强调色:默认是一条灰线,进度条上「看到哪儿了」全靠它,
      灰得和未播段几乎一样就等于没有进度条。
  -->
  <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="{DynamicResource Ink3Color}" />
  <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource AccentColor}" />

  <!-- 布局常量(UI_PC §3.1)。标题栏 36 / 侧栏 212(用户 2026-07-16 定,草稿原为 186)/
       折叠 72 / 正文封顶 1560 / 水槽 18 / 窗口最小 1024×640 -->
  <x:Double x:Key="TitleBarHeight">36</x:Double>
  <x:Double x:Key="SidebarWidth">212</x:Double>
  <x:Double x:Key="SidebarCollapsedWidth">72</x:Double>
  <x:Double x:Key="ContentMaxWidth">1560</x:Double>
  <x:Double x:Key="ContentGutter">18</x:Double>
</ResourceDictionary>
