<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 通知栏播放控制(U1.21):Android 13+ 通知要运行时申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 后台播放(U1.22):前台服务 + 唤醒锁 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 应用内一条龙更新(U1.30)。装包这一步交给系统装包器,我们只发意图。
         ☠ 这个权限只是「允许申请」:用户还得在系统设置里给本应用开「安装未知应用」。
           不查 canRequestPackageInstalls() 就发意图的表现是**什么都不发生** ——
           所以 SettingsPage 里查了,没开就把用户送到那一页去。
         本应用只走自有渠道分发,不上 Google Play,不受该权限的上架限制。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 两条都必须 required=false:电视没有触摸屏,默认的 required=true 会让
         电视桌面和商店把本应用当成「不兼容」藏掉;leanback 反过来会让手机看不到它 -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".LinPlayerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.LinPlayer.Splash">
        <!-- 与启动分流使用同一构建参数，供出包时核对实际界面形态。 -->
        <meta-data android:name="xyz.linplayer.app.TV_BUILD" android:value="${tvBuild}" />
        <!-- 补帧(自编 libmpv 里的 vf=lpinterp)按名字 dlopen 厂商的 OpenCL。targetSdk 31+
             不声明的话,链接器命名空间直接拒掉;required=false:没有的机器照样能装 -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-pixel.so" android:required="false" />
        <!-- Sentry 在 LinPlayerApp 里手动初始化(DSN 可能为空),不走它的自动初始化 -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <!--
          configChanges 吃下形变,不让系统重建 Activity。
          ★ 理由不是省事,是 surface 生命周期:重建会销毁并重建 SurfaceView,
            每转一次屏就要走一遍「阻塞解绑 → 重绑」。U1.28 要快速转 100 次不崩,
            少一半解绑次数就是少一半机会。

          launchMode=singleTask:深链(U1.26)冷启动走 onCreate、热启动走 onNewIntent,
          两条路径都要能拿到 URL。不设的话热启动会开出第二个 Activity 实例。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode|navigation|keyboard"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="${mainLauncherAction}" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- TV 入口。分流靠 UiModeManager,不是两个 Activity;缺 banner 电视桌面是一块空白磁贴 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- U1.26 深链。拿到 URL 之后交 account.parseDeepLink,UI 不自己解析 -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="linplayer" />
            </intent-filter>
        </activity>

        <!-- 方向在创建窗口前由系统确定，共用播放器实现；不接受外部播放参数。 -->
        <activity android:name=".PlayerActivity" android:exported="false"
            android:theme="@style/Theme.LinPlayer.Player" android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode|navigation|keyboard"
            android:supportsPictureInPicture="true" android:resizeableActivity="true" />
        <activity android:name=".PortraitPlayerActivity" android:exported="false"
            android:theme="@style/Theme.LinPlayer.Player" android:screenOrientation="sensorPortrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode|navigation|keyboard"
            android:supportsPictureInPicture="true" android:resizeableActivity="true" />

        <!-- 更新包交给系统装包器要一个 content:// —— Android 7 起 file:// 会当场
             FileUriExposedException。开放范围见 res/xml/file_paths.xml:只有更新包那一个目录。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 诊断进程不运行主进程 provider,播放器崩溃后仍可读取现场。 -->
        <activity android:name=".StartupDiagnosticsActivity" android:exported="true"
            android:enabled="${diagnosticEnabled}"
            android:process=":diagnostics"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="${diagnosticLauncherAction}" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- U1.22 前台服务。Android 14 起 foregroundServiceType 必填 -->
        <service
            android:name=".ui.player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
        </service>
    </application>
</manifest>
